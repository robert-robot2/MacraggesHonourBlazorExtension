@page "/logs"
@inject IJSRuntime JS

<PageTitle>Download Log</PageTitle>

<h3>📋 Download Log</h3>

<div class="log-controls">
    <span>@entries.Count entries</span>
    <button @onclick="ClearLog">🗑️ Clear Log</button>
</div>

@if (entries.Count == 0)
{
    <p>No downloads intercepted yet.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Date/Time</th>
                <th>File</th>
                <th>Source</th>
                <th>Type</th>
                <th>Result</th>
                <th>Scan</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var entry in entries)
            {
                <tr>
                    <td>@entry.Datetime</td>
                    <td>@entry.Filename</td>
                    <td>@entry.Source</td>
                    <td class="@(entry.IsBlob ? "type-blob" : "type-regular")">
                        @(entry.IsBlob ? "📧 Email" : "🌐 Web")
                    </td>
                    <td class="@(entry.Result == "Cancelled" ? "result-cancelled" : "result-allowed")">
                        @(entry.Result == "Cancelled" ? "❌ Cancelled" : "✅ Allowed")
                    </td>
                    <td class="@GetScanClass(entry.ScanStatus)">
                        @GetScanIcon(entry.ScanStatus) @entry.ScanStatus
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="log-section-divider">
    <h3>🚫 Popup Block Log</h3>
</div>

<div class="log-controls">
    <span>@popupEntries.Count entries</span>
    <button @onclick="ClearPopupLog">🗑️ Clear Log</button>
</div>

@if (popupEntries.Count == 0)
{
    <p>No popups blocked yet.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Date/Time</th>
                <th>Attempted URL</th>
                <th>Source Tab</th>
                <th>Type</th>
                <th>Result</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var entry in popupEntries)
            {
                <tr>
                    <td>@entry.Datetime</td>
                    <td>@entry.AttemptedUrl</td>
                    <td>@entry.SourceTab</td>
                    <td>@(entry.PopupType == "window" ? "🪟 Window" : "🗂️ Tab")</td>
                    <td class="result-cancelled">🚫 Blocked</td>
                </tr>
            }
        </tbody>
    </table>
}
<div class="log-section-divider">
    <h3>🛡️ Macragge Scan Log</h3>
</div>

<div class="log-controls">
    <span>@entries.Count(e => e.ScanStatus != "unknown") entries</span>
</div>

@if (!entries.Any(e => e.ScanStatus != "unknown"))
{
    <p>No scans recorded yet.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Date/Time</th>
                <th>File</th>
                <th>Scan Result</th>
                <th>Detail</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var entry in entries.Where(e => e.ScanStatus != "unknown"))
            {
                <tr>
                    <td>@entry.Datetime</td>
                    <td>@entry.Filename</td>
                    <td class="@GetScanClass(entry.ScanStatus)">
                        @GetScanIcon(entry.ScanStatus) @entry.ScanStatus
                    </td>
                    <td>@entry.ScanMessage</td>
                </tr>
            }
        </tbody>
    </table>
}



@code {
    private List<LogEntry> entries = new();

    protected override async Task OnInitializedAsync()
    {
        var result = await JS.InvokeAsync<List<LogEntry>>("chromeInterop.getLog");
        if (result != null)
            entries = Enumerable.Reverse(result).ToList();

        var popupResult = await JS.InvokeAsync<List<PopupLogEntry>>("chromeInterop.getPopupLog");
        if (popupResult != null)
            popupEntries = Enumerable.Reverse(popupResult).ToList();
    }



    private async Task ClearLog()
    {
        await JS.InvokeVoidAsync("chromeInterop.clearLog");
        entries = new();
    }

    private string GetScanClass(string status) => status switch
    {
        "threat" => "result-cancelled",
        "suspicious" => "result-suspicious",
        "clean" => "result-allowed",
        _ => ""
    };

    private string GetScanIcon(string status) => status switch
    {
        "threat" => "🔴",
        "suspicious" => "🟡",
        "clean" => "🟢",
        _ => "⚪"
    };


    private class LogEntry
    {
        public string Datetime { get; set; } = "";
        public string Filename { get; set; } = "";
        public string Source { get; set; } = "";
        public bool IsBlob { get; set; }
        public string Result { get; set; } = "";
        public string ScanStatus { get; set; } = "";
        public string ScanMessage { get; set; } = "";
    }
    private List<PopupLogEntry> popupEntries = new();


    // new clear method:
    private async Task ClearPopupLog()
    {
        await JS.InvokeVoidAsync("chromeInterop.clearPopupLog");
        popupEntries = new();
    }

    // new model class:
    private class PopupLogEntry
    {
        public string Datetime { get; set; } = "";
        public string AttemptedUrl { get; set; } = "";
        public string SourceTab { get; set; } = "";
        public string PopupType { get; set; } = "";
    }


}