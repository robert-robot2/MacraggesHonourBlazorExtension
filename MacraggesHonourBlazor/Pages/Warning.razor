@page "/warning"
@layout WarningLayout
@inject IJSRuntime JS
@implements IDisposable
@using MacraggesHonourBlazor
@inject VirusTotalService VtService
@inject FileScannerService ScannerService

<PageTitle>Macragge's Honour</PageTitle>

<div class="warning-container">
    <img class="bg-image" src="Icons/Background001.png" alt="Macragge's Honour" />
    <div class="overlay">
        <h1>⚠️ Macragge's Honour</h1>
        <h2>Download Interceptor Scanner</h2>

        <div class="file-info">
            <p><strong>File:</strong> @filename</p>
            <p><strong>Source:</strong> @source</p>
            <div class="vt-result">
                @if (isScanning)
                {
                    <p class="vt-scanning">🔍 Scanning with VirusTotal...</p>
                }
                <p class="@vtClass">@vtMessage</p>
            </div>
            <div class="vt-result">
                @if (isCustomScanning)
                {
                    <p class="vt-scanning">🔍 Running Macragge Scanner...</p>
                }
                <p class="@customScanClass">@customScanMessage</p>
            </div>
        </div>

        <p class="warning-text">Are you sure you want to download this file?</p>
        <p class="warning-text">It may contain threats to the Imperium!</p>
        <p class="tvirus">ARE YOU REALLY SURE YOU WANT TO INFECT YOUR COMPUTER WITH THE ZOMBIE T-VIRUS BECAUSE YOU WILL IF YOU HIT YES.</p>

        <div class="buttons">
            <button class="cancel-btn" @onclick="Cancel">CANCEL</button>
            <button class="download-btn" @onclick="DownloadAnyway">DOWNLOAD ANYWAY</button>
        </div>
    </div>
</div>

@code {
    private string filename = "Loading...";
    private string source = "Loading...";
    private string vtMessage = "";
    private string vtClass = "";
    private bool isScanning = false;
    private bool isBlob = false;
    private int downloadId;
    private string blobUrl = "";
    private Timer? pollTimer;
    private string customScanMessage = "";
    private string customScanClass = "";
    private bool isCustomScanning = false;

    private class PendingDownload
    {
        public int Id { get; set; }
        public string? Filename { get; set; }
        public string? Url { get; set; }
        public bool IsBlob { get; set; }
        public VtResult? VtResult { get; set; }
        public List<int>? HeaderBytes { get; set; }
        public string? TextContent { get; set; }
    }

    private class VtResult
    {
        public string Status { get; set; } = "";
        public string Message { get; set; } = "";
    }

    protected override async Task OnInitializedAsync()
    {
        var download = await JS.InvokeAsync<PendingDownload>("chromeInterop.getPendingDownload");
        if (download != null)
        {
            downloadId = download.Id;
            isBlob = download.IsBlob;
            blobUrl = download.Url ?? "";
            source = download.Url ?? "Unknown Source";

            var raw = download.Filename ?? "Email Attachment";
            filename = raw.Split('\\').Last().Split('/').Last();

            if (isBlob)
            {
                vtMessage = "⚪ Email attachment — cannot scan";
                vtClass = "vt-blob";
                isScanning = false;
            }
            else
            {
                isScanning = true;
                isCustomScanning = true;
                StateHasChanged();

                // Run Macragge scanner immediately — data already in pendingDownload
                var headerBytes = download.HeaderBytes?.Select(b => (byte)b).ToArray() ?? Array.Empty<byte>();
                var scanFilename = download.Filename ?? "";
                if (string.IsNullOrEmpty(scanFilename))
                    scanFilename = download.Url?.Split('/').Last().Split('?').First() ?? "unknown";

                var report = await ScannerService.ScanAsync(scanFilename, headerBytes, download.TextContent ?? "");
                customScanMessage = report.FinalMessage;
                customScanClass = $"vt-{report.FinalStatus}";
                isCustomScanning = false;

                // VT scan
                var result = await VtService.ScanUrl(download.Url ?? "");
                vtMessage = result.Message;
                vtClass = $"vt-{result.Status}";
                isScanning = false;
                await JS.InvokeVoidAsync("chromeInterop.updateScanLog", report.FinalStatus, report.FinalMessage);
                StateHasChanged();
            }
        }
    }

    private void StartPolling()
    {
        pollTimer = new Timer(async _ =>
        {
            var updated = await JS.InvokeAsync<PendingDownload>("chromeInterop.pollPendingDownload");
            if (updated?.VtResult != null)
            {
                pollTimer?.Dispose();
                isScanning = false;
                vtMessage = updated.VtResult.Message;
                vtClass = $"vt-{updated.VtResult.Status}";
                await InvokeAsync(StateHasChanged);
            }
        }, null, 1000, 1000);
    }

    private async Task Cancel()
    {
        pollTimer?.Dispose();
        await JS.InvokeVoidAsync("chromeInterop.cancelDownload", downloadId);
        await JS.InvokeVoidAsync("window.close");
    }

    private async Task DownloadAnyway()
    {
        pollTimer?.Dispose();
        if (isBlob)
        {
            await JS.InvokeVoidAsync("chromeInterop.allowBlobDownload", blobUrl, filename);
        }
        else
        {
            await JS.InvokeVoidAsync("chromeInterop.allowRegularDownload", downloadId);
        }
        await JS.InvokeVoidAsync("window.close");
    }

    public void Dispose()
    {
        pollTimer?.Dispose();
    }

    private class ScanData
    {
        public bool Success { get; set; }
        public string? Filename { get; set; }
        public List<int>? HeaderBytes { get; set; }
        public string? TextContent { get; set; }
    }

}